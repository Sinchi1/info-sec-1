<FindBugsFilter>
  <!-- Only this stateless bearer API disables CSRF: no cookies, sessions or HTTP Basic. -->
  <Match>
    <Class name="ru.itmo.secureapi.SecurityConfig"/>
    <Method name="~lambda\$securityFilterChain\$.*"/>
    <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
  </Match>
  <!-- Informational inventory of reviewed controllers, not a vulnerability. -->
  <Match>
    <Class name="ru.itmo.secureapi.ApiController"/>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>
</FindBugsFilter>
